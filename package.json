{
  "name": "nmmpc",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-permissions": "^5.6.3",
    "react-native-qrcode-svg": "^6.3.49",
    "react-native-receipt-printer": "^0.5.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "supabase:start": "npx supabase start",
    "supabase:reset": "npx supabase db reset --local",
    "supabase:lint": "npx supabase db lint --local --level warning",
    "supabase:test": "npx supabase test db",
    "backend:test": "node scripts/backend-acceptance.mjs",
    "billing:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/billing.test.ts",
    "arrears:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/arrears.test.ts",
    "receipt:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/receipt.test.ts tests/virtual-printer.test.mjs",
    "meter-scan:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/meter-scan.test.ts",
    "meter-number:test": "node --test tests/meter-number.test.mjs",
    "session:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/session-errors.test.ts",
    "workflow:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/operation-id.test.ts",
    "phase6:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/meter-recognition.test.ts tests/photo-quality.test.ts",
    "phase6:acceptance:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase6-acceptance.test.ts",
    "phase6:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/phase6-acceptance.mjs",
    "offline:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/offline-schema.test.ts",
    "sync:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/synchronization.test.ts",
    "offline-billing:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/offline-billing.test.ts tests/receipt.test.ts",
    "phase7:acceptance:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/phase7-acceptance.test.ts",
    "phase7:setup": "node scripts/phase7-setup.mjs",
    "phase7:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/phase7-acceptance.mjs",
    "printer:virtual": "node tools/virtual-printer/server.mjs",
    "members:seed-demo": "node scripts/seed-demo-members.mjs",
    "supabase:types": "npx supabase gen types typescript --local --schema public > src/types/database.types.ts"
  },
  "private": true
}
